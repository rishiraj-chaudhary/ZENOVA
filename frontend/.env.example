# Copy to .env and fill in. Never commit .env.
#
# Base URL of the ZENOVA API, including the /api suffix is NOT required —
# config/api.js appends it. Leave unset in local development to default to
# http://localhost:3000/api.
#
# Production (Render): https://zenova-qfsf.onrender.com/api
VITE_API_URL=
