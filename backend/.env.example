# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Public URL of the React app. Used for CORS and for building invite links.
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/therapy

# Both must be long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

GEMINI_API_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://localhost:5173/spotify-callback
